{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-VERCEL-API.vercel.app/api/:path*"
    },
    {
      "source": "/users/:id/photo",
      "destination": "https://YOUR-VERCEL-API.vercel.app/api/users/:id/photo"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://YOUR-VERCEL-API.vercel.app/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
